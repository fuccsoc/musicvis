{
  "name": "musicvis",
  "version": "0.1.0",
  "description": "Minimal macOS Now Playing visualizer with system audio waveform, artwork, and synced lyrics",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "npm run build:main && npm run build:native && wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:native": "bash scripts/build-native.sh",
    "build:mac": "npm run build && npm run build:native && electron-builder --mac --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "keywords": [
    "macos",
    "electron",
    "react",
    "music",
    "visualizer",
    "now-playing",
    "screen-capturekit",
    "lyrics"
  ],
  "author": "fuccsoc",
  "license": "WTFPL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuccsoc/musicvis.git"
  },
  "bugs": {
    "url": "https://github.com/fuccsoc/musicvis/issues"
  },
  "homepage": "https://github.com/fuccsoc/musicvis#readme",
  "type": "commonjs",
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "jsdom": "^27.0.0",
    "typescript": "^5.6.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "build": {
    "extends": null,
    "appId": "com.fuccsoc.musicvis",
    "productName": "musicvis",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/native",
        "to": "native",
        "filter": [
          "AudioCaptureHelper",
          "MediaRemoteHelper",
          "libMediaRemoteAdapter.dylib",
          "MediaRemoteAdapter.framework/**",
          "MediaRemoteAdapter_*.bundle/**"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
